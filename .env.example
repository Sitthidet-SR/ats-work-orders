# Copy to .env in the repository root; scripts load this file.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ats:ats_local@localhost:5432/ats?schema=public
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
ADMIN_INITIAL_PASSWORD=
SEED_DEMO=false
# Cross-origin Vercel/Render uses SameSite=None; production cookies are Secure.
COOKIE_SAME_SITE=lax
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=ats-private
STORAGE_ACCESS_KEY=ats_local
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
CHROMIUM_EXECUTABLE_PATH=
